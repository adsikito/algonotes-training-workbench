# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# v2 本地数据库（可由 v2/db/migrate-0001.mjs 重建，含 WAL/SHM 临时文件）
/v2/data/

# Local environment and keys
.env*
.dev.vars*
*.pem
/.openai/

# Checkout-local tool state
/.wrangler/
/.sites-runtime/
/.mimosa/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store
